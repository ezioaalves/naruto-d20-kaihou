<section class="kaihou-downtime-console">
  <header class="downtime-mode">
    <button type="button" data-action="toggleMode">
      {{#if active}}End Downtime{{else}}Start Downtime{{/if}}
    </button>
    <span class="status">Downtime: {{#if active}}ON{{else}}OFF{{/if}}</span>
  </header>

  {{#if active}}
    <section class="downtime-block">
      <p class="date">{{dateLabel}}</p>
      <div class="block-picker">
        {{#each blocks as |b|}}
          <button type="button" data-action="promptBlock" data-block="{{b}}"
            class="{{#if (eq b ../suggestedBlock)}}suggested{{/if}}">{{b}}</button>
        {{/each}}
      </div>
    </section>

    {{#if hasBlock}}
      <section class="downtime-recipients">
        <h3>Recipients</h3>
        <ul>{{#each recipients as |r|}}<li>{{r.actorName}} — {{r.status}}</li>{{/each}}</ul>
      </section>

      <section class="downtime-responses">
        <h3>Responses (in order)</h3>
        <ol>
          {{#each responses as |r|}}
            <li>
              <b>{{r.actorName}}</b>: {{r.action}}{{#if r.detail}} ({{r.detail}}){{/if}}{{#if r.scene}} <em>(scene)</em>{{/if}}
              — <span class="result">{{r.resultLabel}}</span>
              {{#if r.note}}<span class="note">"{{r.note}}"</span>{{/if}}
              {{#if r.canRun}}
                <button type="button" data-action="runOne" data-submission-id="{{r.id}}">Run</button>
              {{/if}}
            </li>
          {{else}}
            <li class="empty">No responses yet.</li>
          {{/each}}
        </ol>
      </section>

      <section class="downtime-queues">
        <h3>Scene queue</h3>
        <ol>
          {{#each sceneRows as |r|}}
            <li>{{r.actorName}} — {{r.action}}
              {{#if r.canRun}}<button type="button" data-action="runOne" data-submission-id="{{r.id}}">Run</button>{{/if}}
            </li>
          {{else}}<li class="empty">Empty.</li>{{/each}}
        </ol>
        <h3>Other queue</h3>
        <ol>{{#each otherRows as |r|}}<li>{{r.actorName}} — {{r.action}}</li>{{else}}<li class="empty">Empty.</li>{{/each}}</ol>
      </section>

      <section class="downtime-rolllog">
        <h3>Roll log</h3>
        <ul>{{#each rollLog as |r|}}<li>{{r.actorName}}: {{r.resultLabel}}</li>{{else}}<li class="empty">No resolved rolls.</li>{{/each}}</ul>
      </section>

      <footer class="downtime-actions">
        <button type="button" data-action="closeCollection">Close collection</button>
        <button type="button" data-action="postSummary">Post chat summary</button>
      </footer>
    {{/if}}

    <section class="downtime-extensions" data-downtime-extensions></section>
  {{else}}
    <p class="downtime-inactive">Downtime Mode is off. Start downtime to prompt the party.</p>
  {{/if}}
</section>
