{{!-- Nested picker: radio + conditional sub-picker (Q7, Q8, Q13) --}}
<div class="tqw-nested-group" data-state-field="{{current.stateField}}">
  {{#each current.options}}
    <label class="tqw-nested-option">
      <input type="radio" name="pick-{{../current.id}}" value="{{value}}"
             {{#if (eq value ../current.stateValue)}}checked{{/if}}
             data-qid="{{../current.id}}"
             data-reveal="{{value}}" />
      {{#if icon}}<img src="{{icon}}" alt="" />{{/if}}
      <span>{{label}}</span>
    </label>
  {{/each}}

  {{#if current.subPicker}}
    <div class="tqw-subpicker" data-subpicker-type="{{current.subPicker.type}}" style="display: none;">
      <label>{{current.subPicker.label}}</label>
      {{#if (eq current.subPicker.type "select")}}
        <select name="sub-pick-{{current.id}}" data-state-field="{{current.subPicker.stateField}}">
          <option value="">-- Choose --</option>
          {{#each current.subPicker.options}}
            <option value="{{value}}" {{#if (eq value ../current.subPickerValue)}}selected{{/if}}>
              {{label}}
            </option>
          {{/each}}
        </select>
      {{/if}}
      {{#if (eq current.subPicker.type "select-grouped")}}
        <select name="sub-pick-{{current.id}}" data-state-field="{{current.subPicker.stateField}}" class="tqw-grouped-select">
          <option value="">-- Choose --</option>
          {{#each current.subPicker.options}}
            <option value="{{value}}" data-group="{{group}}" {{#if (eq value ../current.subPickerValue)}}selected{{/if}}>
              {{label}}
            </option>
          {{/each}}
        </select>
      {{/if}}
    </div>
  {{/if}}
</div>
