{{!--
  Kaihou bespoke databook character sheet.

  This is a fork of PF1e's systems/pf1/templates/actors/character-sheet.hbs:
  the chrome (header band + Identity dossier + databook tab strip) is ours, but
  every functional tab embeds PF1e's own partial verbatim, so all PF1e bindings,
  listeners and rolls keep working unchanged. The two anchor selectors the
  naruto-d20 chakra patch relies on — nav.sheet-navigation.tabs[data-group=
  'primary'] and section.primary-body — are preserved, so the Chakra tab still
  injects. Databook view-model fragments come from getData() as `kaihou.*`.
--}}
<form class="{{cssClass}} kaihou-databook-form" data-tooltip-class="pf1" autocomplete="off">

  {{#unless hasClasses}}<span class="charactermancer warning">{{localize "PF1.Info_MissingClass"}}</span>{{/unless}}

  {{!-- Databook header band (always visible, above the tab strip) --}}
  {{{kaihou.fragments.headerBand}}}

  {{!-- Compact Quick Actions strip — owner-only (limited viewers see Identity only). --}}
  {{#if kaihou.isOwner}}
  {{#if quickActions.length}}
  <div class="db-quick-strip">
    <ol class="quick-actions">
      {{#each quickActions}}
      <li class="item" data-item-id="{{id}}" data-type="{{type}}" data-tooltip="{{name}}">
        <img src="{{img}}">
        {{#if isCharged}}
        <charges>
        {{~#if recharging~}}<span class="recharge">+{{uses}}</span>
        {{~else~}}<span class="remaining">{{uses}}</span>{{~#if max~}}<span class="delimiter">/</span><span class="max">{{max}}</span>{{~/if~}}
        {{~/if~}}
        </charges>
        {{/if}}
      </li>
      {{/each}}
    </ol>
  </div>
  {{/if}}
  {{/if}}

  {{!-- PC Sheet Navigation — limited viewers see only Identity; owners see all tabs. --}}
  <nav class="sheet-navigation tabs" data-group="primary">
    {{#if kaihou.isOwner}}<a class="item" data-tab="summary" data-group="primary"><i class="fa-solid fa-user"></i><span class="db-tab-label">{{ localize "PF1.Summary" }}</span></a>{{/if}}
    <a class="item" data-tab="identity" data-group="primary"><i class="fa-solid fa-id-card"></i><span class="db-tab-label">Identity</span></a>
    {{#if kaihou.isOwner}}
    <a class="item" data-tab="combat" data-group="primary"><i class="fa-solid fa-hand-fist"></i><span class="db-tab-label">{{ localize "PF1.Combat" }}</span></a>
    <a class="item" data-tab="skills" data-group="primary"><i class="fa-solid fa-list-check"></i><span class="db-tab-label">{{ localize "PF1.Skills" }}</span></a>
    <a class="item" data-tab="attributes" data-group="primary"><i class="fa-solid fa-dumbbell"></i><span class="db-tab-label">{{ localize "PF1.Attributes" }}</span></a>
    <a class="item" data-tab="inventory" data-group="primary"><i class="fa-solid fa-briefcase"></i><span class="db-tab-label">{{ localize "PF1.Inventory" }}</span></a>
    <a class="item" data-tab="feats" data-group="primary"><i class="fa-solid fa-star"></i><span class="db-tab-label">{{ localize "PF1.Features" }}</span></a>
    {{#if usesAnySpellbook}}<a class="item" data-tab="spellbook" data-group="primary"><i class="fa-solid fa-book"></i><span class="db-tab-label">{{ localize "PF1.Spells" }}</span></a>{{/if}}
    <a class="item" data-tab="buffs" data-group="primary"><i class="fa-solid fa-bolt"></i><span class="db-tab-label">{{ localize "PF1.Buffs" }}</span></a>
    <a class="item" data-tab="biography" data-group="primary"><i class="fa-solid fa-scroll"></i><span class="db-tab-label">{{ localize "PF1.Biography" }}</span></a>
    <a class="item" data-tab="notes" data-group="primary"><i class="fa-solid fa-note-sticky"></i><span class="db-tab-label">{{ localize "PF1.Notes" }}</span></a>
    <a class="item" data-tab="settings" data-group="primary"><i class="fa-solid fa-gear"></i><span class="db-tab-label">{{ localize "PF1.Settings" }}</span></a>
    {{/if}}
  </nav>

  {{!-- PC Sheet Body --}}
  <section class="primary-body">

    {{!-- Identity (databook front matter — Kaihou-owned) --}}
    <div class="tab identity flexcol" data-group="primary" data-tab="identity">
      <div class="db-frontmatter">
        <div class="db-identity-edit">
          <label>Alias
            {{#if kaihou.isOwner}}<input type="text" name="flags.naruto-d20-kaihou.alias" value="{{kaihou.identity.alias}}" placeholder="—">{{else}}<span class="db-identity-ro">{{#if kaihou.identity.alias}}{{kaihou.identity.alias}}{{else}}—{{/if}}</span>{{/if}}
          </label>
          <label>Allegiance
            {{#if kaihou.isOwner}}<input type="text" name="flags.naruto-d20-kaihou.allegiance" value="{{kaihou.identity.allegiance}}" placeholder="—">{{else}}<span class="db-identity-ro">{{#if kaihou.identity.allegiance}}{{kaihou.identity.allegiance}}{{else}}—{{/if}}</span>{{/if}}
          </label>
        </div>

        <div class="db-panel db-panel--natures">
          <h4 class="db-panel__h">Chakra Natures</h4>
          {{{kaihou.fragments.naturesFull}}}
        </div>

        <div class="db-radars">
          <div class="db-panel"><h4 class="db-panel__h">Ability Scores</h4>{{{kaihou.fragments.abilityRadar}}}</div>
          <div class="db-panel"><h4 class="db-panel__h">Disciplines</h4>{{{kaihou.fragments.disciplineRadar}}}</div>
        </div>

        <div class="db-row2">
          {{{kaihou.fragments.missionRecord}}}
          <div class="db-panel">
            <h4 class="db-panel__h">Origin &amp; Path</h4>
            {{#each kaihou.origin}}
              <div class="db-line"><span>{{this.label}}</span><span>{{#if this.value}}{{this.value}}{{else}}—{{/if}}</span></div>
            {{/each}}
          </div>
        </div>

        {{!-- Collaborative notes: private (this player) + public (whole party) --}}
        <div class="db-row2 db-notes">
          <div class="db-panel">
            <h4 class="db-panel__h">My Notes <span class="db-notes__hint">private</span></h4>
            <textarea class="db-notes__private" rows="5" placeholder="Your private notes on this character…">{{kaihou.notes.privateNote}}</textarea>
          </div>
          <div class="db-panel">
            <h4 class="db-panel__h">Party Notes <span class="db-notes__hint">shared</span></h4>
            <textarea class="db-notes__public" rows="5" placeholder="Notes the whole party can see…">{{kaihou.notes.publicNote}}</textarea>
          </div>
        </div>
      </div>
    </div>

  {{!-- Owner-only tabs: all functional PF1e tabs. Limited viewers land on Identity. --}}
  {{#if kaihou.isOwner}}
    {{!-- Details (PF1e summary) --}}
    <div class="tab summary flexcol" data-group="primary" data-tab="summary">
      {{> "systems/pf1/templates/actors/parts/actor-summary.hbs"}}
    </div>

    <div class="tab attributes flexcol" data-group="primary" data-tab="attributes">
      {{> "systems/pf1/templates/actors/parts/actor-attributes.hbs"}}
    </div>

    {{!-- Combat Tab --}}
    <div class="tab combat flexcol" data-group="primary" data-tab="combat">
      {{~> "systems/pf1/templates/actors/parts/actor-combat.hbs" sections=attacks}}
    </div>

    {{!-- Inventory Tab --}}
    <div class="tab inventory flexcol" data-group="primary" data-tab="inventory">
      {{> "systems/pf1/templates/actors/parts/actor-inventory.hbs" sections=inventory}}
    </div>

    {{!-- Features Tab --}}
    <div class="tab features flexcol" data-group="primary" data-tab="feats">
      {{> "systems/pf1/templates/actors/parts/actor-features.hbs" sections=features}}
    </div>

    {{!-- Skills Tab --}}
    <div class="tab skills flexcol{{#if @root.skillsLocked}} locked{{/if}}" data-group="primary" data-tab="skills">
      {{> "systems/pf1/templates/actors/parts/actor-skills-front.hbs"}}
    </div>

    {{!-- Buffs Tab --}}
    <div class="tab buffs flexcol" data-group="primary" data-tab="buffs">
      {{> "systems/pf1/templates/actors/parts/actor-buffs.hbs" sections=buffs}}
    </div>

    {{!-- Spellbook Tab --}}
    {{#if usesAnySpellbook}}
    <div class="tab spellbook flexcol" data-group="primary" data-tab="spellbook">
      {{~> "systems/pf1/templates/actors/parts/actor-spellbook-front.hbs"}}
    </div>
    {{/if}}

    {{!-- Biography Tab --}}
    <div class="tab biography flexcol" data-group="primary" data-tab="biography">
      {{editor biographyHTML target="system.details.biography.value" toggle=_editorState.system.details.biography.value button=_editorState.system.details.biography.value engine="prosemirror" editable=@root.editable}}
    </div>

    {{!-- Notes Tab --}}
    <div class="tab actor-notes flexcol" data-group="primary" data-tab="notes">
      <div class="primary-content">
        {{editor notesHTML target="system.details.notes.value" toggle=_editorState.system.details.notes.value button=_editorState.system.details.notes.value engine="prosemirror" editable=@root.editable}}
      </div>

      {{#if magicItems}}
      {{> "systems/pf1/templates/internal/table_magic-items.hbs" items=magicItems}}
      {{/if}}
    </div>

    {{!-- Settings Tab --}}
    <div class="tab settings flexcol" data-group="primary" data-tab="settings">
      {{> "systems/pf1/templates/actors/parts/actor-settings.hbs"}}
    </div>
  {{/if}}
  </section>
</form>
